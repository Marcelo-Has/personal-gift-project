{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run test*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm ci*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/secrets*)",
      "Read(**/serviceAccount*.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qiE 'sk-ant-|BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|STRIPE_SECRET|AKIA[0-9A-Z]{16}' <<< \"$CLAUDE_TOOL_INPUT\" && { echo 'Bloqueado: possível segredo no comando'; exit 2; } || exit 0"
          }
        ]
      }
    ]
  }
}
