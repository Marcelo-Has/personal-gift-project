{
	"name": "personal-gift-project",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.22.2"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test": "npm run check && npm run test:unit",
		"test:rules": "npx -y firebase-tools@15.24.0 emulators:exec --project demo-personal-gift --only auth,firestore,storage \"vitest run --config vitest.rules.config.ts\"",
		"test:e2e": "playwright test",
		"test:e2e:install-browsers": "playwright install --with-deps chromium"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@firebase/rules-unit-testing": "^5.0.1",
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"jsdom": "^30.0.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"firebase": "^12.16.0",
		"firebase-admin": "^14.2.0",
		"jimp": "^1.6.1",
		"stripe": "^22.4.0",
		"zod": "^4.4.3"
	},
	"overrides": {
		"rimraf": "^6.0.1",
		"jwks-rsa": {
			"jose": "^5.10.0"
		},
		"brace-expansion": "^5.0.9"
	}
}
